#N canvas 172 54 1342 725 12;
#X declare -lib fd_lib;
#X text 92 134 To convert a frequency f (Hz) into Bark use:;
#N canvas 0 22 450 278 (subpatch) 0;
#X array bark-0 20000 float 2;
#A color 0;
#A width 2;
#X coords 0 40 20000 20 200 140 1 0 0;
#X restore 305 191 graph;
#X text 270 173 40 ________________20, f 2;
#X text 57 263 3.5 * arctan((f/7500)^2) \,;
#X obj 29 158 bng 15 250 50 0 empty onload empty 17 7 0 10 #fcfcfc #000000 #000000;
#X text 18 238 13*arctan(0.00076*f) +;
#X text 283 336 0------------------------------20000 (Hz);
#X obj 29 182 fd_bark 20 20000 bark-0 0;
#X text 28 521 if result < 2 add 0.15*(2-result);
#X text 30 542 if result > 20.1 add 0.22*(result-20.1);
#X text 107 374 OR (Traunmüller 1990) Critical band rate (bark) =;
#N canvas 0 22 450 278 (subpatch) 0;
#X array bark-1 20000 float 2;
#A color 0;
#A width 2;
#X coords 0 30 20000 0 200 140 1 0 0;
#X restore 365 432 graph;
#X text 341 576 0------------------------------20000 (Hz);
#X text 340 417 30 ________________0, f 2;
#X text 13 476 [(26.81f)/(1960+f)]-0.53 \,;
#X obj 19 406 bng 15 250 50 0 empty onload empty 17 7 0 10 #fcfcfc #000000 #000000;
#X obj 19 430 fd_bark 20 20000 bark-1 1;
#X text 642 196 (Hz)=52548/(z^2-52.56z+690.39) \, with z in bark.;
#X text 641 157 Critical bandwidth;
#N canvas 0 22 450 278 (subpatch) 0;
#X array critical-0 20000 float 2;
#A color 0;
#A width 2;
#X coords 0 50 20000 0 200 140 1 0 0;
